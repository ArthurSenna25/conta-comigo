    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "3.6.1",
    "@supabase/ssr": "^0.12.7",
