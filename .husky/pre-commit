# Husky roda com `sh -e`: grep sem match nao pode abortar o script (|| true).
# 1) bloqueia arquivos .env* (exceto .env.example)
blocked=$(git diff --cached --name-only | grep -E '(^|/)\.env' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "BLOQUEADO: arquivo(s) .env no commit:"; echo "$blocked"; exit 1
fi
# 2) segredos no que esta staged
gitleaks git --pre-commit --staged --redact --no-banner || exit 1
# 3) lint dos arquivos staged
pnpm exec lint-staged
