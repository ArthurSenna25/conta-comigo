# Copie para .env.local e preencha. NUNCA versione valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# So servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_DAILY_BUDGET_CENTS=
NEXT_PUBLIC_USE_MOCKS=
# Conta de demonstração (acesso do júri). Só servidor, nunca NEXT_PUBLIC_. Valores só no .env.local e na Vercel.
# Crie/resete a conta com: pnpm seed:demo
DEMO_EMAIL=
DEMO_PASSWORD=
# Teto diário de IA da demo, em centavos (padrão 100; vale o menor entre este e AI_DAILY_BUDGET_CENTS).
DEMO_AI_DAILY_BUDGET_CENTS=
# Chamadas de IA por dia, reservadas no banco (reservar_uso_ia). Só servidor.
# Por usuário (padrão 30) e da demo (padrão 15; vale o menor dos dois).
AI_DAILY_CALLS_USER=
DEMO_AI_DAILY_CALLS=
# Global do dia, SEM padrão: vazio ou inválido nega toda chamada. AI_DAILY_BUDGET_CENTS também precisa ser > 0.
AI_DAILY_CALLS_GLOBAL=
